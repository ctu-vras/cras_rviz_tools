<package format="3">
  <name>cras_rviz_vision_msgs</name>
  <version>0.1.0</version>
  <description>Provides RViz visualizations of vision_msgs messages.</description>
  <maintainer email="peckama2@fel.cvut.cz">Martin Pecka</maintainer>
  <license>Apache-2.0</license>

  <author>Martin Pecka</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>cras_cpp_common</depend>
  <depend>cv_bridge</depend>
  <depend>geometry_msgs</depend>
  <depend>image_transport</depend>
  <depend>libopencv-dev</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rviz_common</depend>
  <depend>rviz_rendering</depend>
  <depend>sensor_msgs</depend>
  <depend>vision_msgs</depend>

  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>cras_lint</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
